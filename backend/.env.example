# ===== Grievance Desk API (FastAPI) configuration =====
# Copy to `.env` and adjust. All values are read from environment or this file.

# --- Database (PostgreSQL via asyncpg) ---
# Docker Compose default points at the `db` service. For local dev, point at your own
# Postgres instance, e.g.: postgresql+asyncpg://app:app@localhost:5432/grievance
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/grievance

# --- Auth ---
# CHANGE THIS in any real deployment.
JWT_SECRET=CHANGE_ME_super_secret_grievance_jwt

# --- Encryption at rest ---
# Encrypts SMTP/IMAP passwords and Gemini API keys stored in the database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank for local dev (a key is derived from JWT_SECRET); set explicitly in production.
ENCRYPTION_KEY=

# --- Gemini AI ---
# Platform-wide fallback key. Paste your key below — organizations can also set their own
# key in Org Settings, which overrides this. When both are empty, classification falls back
# to a keyword/regex rule engine (no API needed, lower accuracy).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- SMTP (platform-wide fallback, optional) ---
# Used to send ack/assignment/resolved/escalation emails when an organization hasn't
# configured its own SMTP account yet. Leave blank to require each org to configure its own.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@grievancedesk.local
SMTP_SSL=true

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Platform Super Admin (seeded on first boot; oversees organizations only) ---
SUPERADMIN_EMAIL=superadmin@grievancedesk.platform
SUPERADMIN_PASSWORD=ChangeMe_SuperAdmin_2026!
SUPERADMIN_NAME=Platform Super Admin

# --- Background jobs ---
IMAP_POLL_INTERVAL_SECONDS=60
SLA_CHECK_INTERVAL_SECONDS=120

# --- Frontend URL ---
# Public base URL of the deployed frontend SPA. Used to build deep links inside
# notification emails (e.g. "Open Ticket TKT-2026-1001": FRONTEND_URL/?ticket=TKT-2026-1001).
FRONTEND_URL=http://localhost:5173

# --- WhatsApp Business Cloud API (Meta), platform-wide fallback ---
# Create a Meta App + WhatsApp Business product at https://developers.facebook.com/apps to get
# these. Organizations can also set their own in Org Settings, which overrides this. Leave blank
# to disable outbound WhatsApp sends (inbound intake still works either way).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta App Secret — verifies inbound webhook signatures (X-Hub-Signature-256). Strongly
# recommended once a real number is connected.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
